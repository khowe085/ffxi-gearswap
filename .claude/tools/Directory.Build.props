<Project>
  <!-- Every file-based app in this folder also compiles lib/*.cs, the code they share.
       The tools run from the builds the launcher, .claude/gear.cs, makes; after a change here or
       under lib/, its build command makes them again. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)lib/*.cs" />
  </ItemGroup>
  <!-- A file-based app is built for native AOT unless told otherwise, and that turns off the
       reflection System.Text.Json uses to read and write the tools' JSON classes. -->
  <PropertyGroup>
    <PublishAot>false</PublishAot>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
</Project>
