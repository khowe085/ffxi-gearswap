<Project>
  <!-- Every file-based app in this folder also compiles lib/*.cs, the code they share.
       dotnet run only watches the app's own file for changes, so the tools are run through the
       launcher, .claude/gear.cs, which builds an app again when this file or lib/ changes. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)lib/*.cs" />
  </ItemGroup>
  <!-- A file-based app is built for native AOT unless told otherwise, and that turns off the
       reflection System.Text.Json uses to read and write the tools' JSON classes. -->
  <PropertyGroup>
    <PublishAot>false</PublishAot>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
</Project>
